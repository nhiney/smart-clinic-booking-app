rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email == 'admin@icare.com'
      );
    }

    function isDoctor() {
      return isSignedIn() && (
        request.auth.token.role == 'doctor' ||
        request.auth.token.role == 'DOCTOR' ||
        request.auth.token.email == 'annv.choray@icare.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'DOCTOR'))
      );
    }

    // --- ICare Collections ---

    // Khung giờ khám (Slots)
    match /slots/{slotId} {
      // Cho phép đọc và ghi công khai để phục vụ việc Seed dữ liệu mẫu và chạy Kiosk
      allow read, write: if true;
    }

    // Lịch hẹn (Bookings)
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.patientId || isAdmin());
      allow create: if true; 
      allow update, delete: if isAdmin();
    }

    // L?ch h?n (Appointments)
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.patientId || 
        request.auth.uid == resource.data.doctorId || 
        isDoctor() || 
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.patientId || 
        request.auth.uid == resource.data.doctorId || 
        isDoctor() || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Th?ng b?o (Notifications)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Các quy tắc khác giữ nguyên...
    match /users/{userId} {
      allow read: if isSignedIn();
      allow update: if request.auth.uid == userId || isDoctor() || isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Ca khám (Encounters)
    match /encounters/{encounterId} {
      allow read, write: if isDoctor() || isAdmin();
    }

    // Kế hoạch điều trị (Treatment Plans)
    match /treatment_plans/{planId} {
      allow read, write: if isDoctor() || isAdmin() || (isSignedIn() && request.auth.uid == resource.data.patientId);
    }

    // Bệnh án (Medical Records)
    // Read: bệnh nhân xem bệnh án của mình, bác sĩ, admin, hoặc bất kỳ user đã đăng nhập
    // (Custom claims chưa được set qua Cloud Functions nên isDoctor() không tin cậy)
    match /medical_records/{recordId} {
      allow read: if isSignedIn();
      allow write: if isDoctor() || isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isAdmin();

      match /departments/{deptId} {
        allow read: if true;
        allow write: if isAdmin();

        match /rooms/{roomId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    match /registered_phones/{phone} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /qr_tokens/{token} {
      allow read: if true;
      allow write, delete: if isSignedIn();
    }

    match /sessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Khảo sát (Surveys)
    match /surveys/{surveyId} {
      allow read: if true;
      allow update: if isSignedIn(); // To increment responseCount
      allow write: if isAdmin();
    }

    match /survey_responses/{responseId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }

    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}